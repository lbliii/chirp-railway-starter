{
  "$schema": "https://raw.githubusercontent.com/lbliii/chirp-railway-catalog/main/schema/template-manifest.schema.json",
  "schema_version": 1,
  "template": {
    "slug": "chirp-launch-board",
    "title": "Python + HTMX Full-Stack Starter — powered by Chirp",
    "repository": "https://github.com/lbliii/chirp-railway-starter",
    "ref": "v0.1.3",
    "python": "3.14",
    "chirp_spec": ">=0.10,<0.11",
    "chirp_locked": "0.10.0",
    "start_command": "python app.py",
    "health_path": "/ready",
    "owner": "lbliii",
    "support_url": "https://github.com/lbliii/chirp-railway-starter/issues",
    "status": "draft",
    "public_url": "https://web-production-e37a56.up.railway.app",
    "demo_url": "https://web-production-e37a56.up.railway.app",
    "last_successful_smoke": "2026-07-14T20:35:43.588407+00:00",
    "services": ["web"],
    "variables": [
      {"name": "PORT", "source": "railway", "secret": false},
      {"name": "CHIRP_ENV", "source": "template", "secret": false},
      {"name": "CHIRP_SECRET_KEY", "source": "template", "secret": true}
    ]
  },
  "required_categories": [
    "asset",
    "form",
    "full-page",
    "health",
    "htmx",
    "oob",
    "readiness",
    "sse"
  ],
  "required_operations": [
    "deployment",
    "ejection",
    "restart",
    "rollback",
    "shutdown",
    "update"
  ],
  "checks": [
    {
      "id": "full-page",
      "category": "full-page",
      "path": "/",
      "contains": ["Launch Board", "Ship your first Chirp app"],
      "extract": {"csrf": "name=\"_csrf_token\" value=\"([^\"]+)\""}
    },
    {
      "id": "malformed-form",
      "category": "form",
      "method": "POST",
      "path": "/items",
      "request_headers": {
        "Content-Type": "application/x-www-form-urlencoded",
        "HX-Request": "true",
        "HX-Target": "board"
      },
      "body": "title=&_csrf_token={{csrf}}",
      "contains": ["Give the next step a short name.", "hx-swap-oob"]
    },
    {
      "id": "no-js-add",
      "category": "form",
      "method": "POST",
      "path": "/items",
      "request_headers": {"Content-Type": "application/x-www-form-urlencoded"},
      "body": "title=Invite+the+first+tester&_csrf_token={{csrf}}",
      "contains": ["Invite the first tester", "Launch Board"]
    },
    {
      "id": "htmx-complete",
      "category": "oob",
      "method": "POST",
      "path": "/items/2/toggle",
      "request_headers": {
        "Content-Type": "application/x-www-form-urlencoded",
        "HX-Request": "true",
        "HX-Target": "board"
      },
      "body": "_csrf_token={{csrf}}",
      "contains": ["Make one tiny change", "shipped", "hx-swap-oob"]
    },
    {
      "id": "htmx-filter",
      "category": "htmx",
      "path": "/?filter=active",
      "request_headers": {"HX-Request": "true", "HX-Target": "board"},
      "contains": ["id=\"board\"", "Ship your first Chirp app"]
    },
    {
      "id": "oob-progress",
      "category": "oob",
      "path": "/?filter=done",
      "request_headers": {"HX-Request": "true", "HX-Target": "board"},
      "contains": ["hx-swap-oob", "id=\"progress\""]
    },
    {
      "id": "no-js-reset",
      "category": "form",
      "method": "POST",
      "path": "/reset",
      "request_headers": {"Content-Type": "application/x-www-form-urlencoded"},
      "body": "_csrf_token={{csrf}}",
      "contains": ["Deploy the starter", "Make one tiny change"]
    },
    {
      "id": "sse-status",
      "category": "sse",
      "path": "/events",
      "headers": {"content-type": "text/event-stream"},
      "contains": ["event: live-status", "Launch Board is live"],
      "stream": true
    },
    {
      "id": "sse-reconnect",
      "category": "sse",
      "path": "/events",
      "headers": {"content-type": "text/event-stream"},
      "contains": ["event: live-status", "Launch Board is live"],
      "stream": true
    },
    {
      "id": "asset",
      "category": "asset",
      "path": "/styles.css",
      "headers": {"content-type": "text/css"},
      "contains": ["--ink:"]
    },
    {"id": "health", "category": "health", "path": "/health"},
    {"id": "readiness", "category": "readiness", "path": "/ready"},
    {"id": "readiness-head", "category": "readiness", "method": "HEAD", "path": "/ready"}
  ]
}
